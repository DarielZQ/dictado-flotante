{
  "name": "dictado-flotante",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensión de Firefox: botón flotante de dictado por voz que inserta el texto en el campo activo.",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "dev": "web-ext run --source-dir dist --browser-console",
    "lint": "web-ext lint --source-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "package": "web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
    "sign": "web-ext sign --source-dir dist --artifacts-dir artifacts --channel unlisted",
    "serve:test-pages": "node tools/serve-test-pages.mjs"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  }
}
